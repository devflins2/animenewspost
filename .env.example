# ==========================================
# INSTAGRAM AUTO-POST CONFIGURATION (EXAMPLE)
# ==========================================

INSTAGRAM_ACCESS_TOKEN="your_instagram_access_token_here"
INSTAGRAM_ACCOUNT_ID="your_instagram_account_id_here"
INSTAGRAM_HANDLE="@your_instagram_handle"

ANIME_API_URL="https://animeapinews.onrender.com/api/v1/posts"
IMAGE_ASPECT_RATIO="4:5"
POST_INTERVAL_MINUTES=60
MAX_RETRIES=3
RETRY_DELAY_SECONDS=15

# ==========================================
# PERMANENT CLOUD DATABASE (PREVENTS DUPLICATES)
# ==========================================
# MongoDB Atlas Free Tier URI (e.g. mongodb+srv://user:pass@cluster.mongodb.net/...)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"

# ==========================================
# FACEBOOK PAGE DUAL-POSTING (OPTIONAL)
# ==========================================
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
